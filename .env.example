# PostgreSQL Database Connection (Supabase / Neon / Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vsecure_hrms?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/vsecure_hrms?schema=public"

# Regional Settings
NEXT_PUBLIC_TIMEZONE="Asia/Kolkata"
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_LOCALE="en-IN"

# Super Administrator Seed Credentials
SUPER_ADMIN_CODE="VS-001"
SUPER_ADMIN_NAME="Vishnu"
SUPER_ADMIN_EMAIL="vishnu@vsecuretechnologies.com"
INITIAL_CAPACITY=25

# Office Geofence Defaults
DEFAULT_HQ_LATITUDE=12.9352
DEFAULT_HQ_LONGITUDE=77.6946
DEFAULT_HQ_RADIUS_METERS=100

# Security (REQUIRED in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""
# Initial password used by the seed script (required when seeding in production)
SEED_DEFAULT_PASSWORD=""
# Demo mode helpers: leave unset/false in production
ALLOW_DEMO_LOGIN="false"
NEXT_PUBLIC_SHOW_DEMO_LOGIN="false"
