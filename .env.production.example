# ==============================================================================
# VSecure Technologies HRMS - Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.production on your production server.
# NEVER commit the filled .env.production containing actual secrets into source control!
# ==============================================================================

# 1. DATABASE CONNECTIVITY (PostgreSQL with SSL & PgBouncer Connection Pooling)
# Pooled connection string for application runtime (e.g. Supabase / Neon / AWS RDS)
DATABASE_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@db.vsecuretechnologies.com:6543/vsecure_hrms?sslmode=require&pgbouncer=true"
# Direct unpooled connection string for Prisma migrations
DIRECT_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@db.vsecuretechnologies.com:5432/vsecure_hrms?sslmode=require"

# 2. APPLICATION RUNTIME & SECURITY
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_URL="https://hrms.vsecuretechnologies.com"
SESSION_SECRET="generate_a_64_character_random_hex_key_here_for_cookie_signing"
SESSION_EXPIRY_HOURS=24

# 3. REGIONAL & FINANCIAL STANDARDS (Strictly Enforced)
NEXT_PUBLIC_TIMEZONE="Asia/Kolkata"
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_LOCALE="en-IN"

# 4. SUPER ADMINISTRATOR RECOVERY INITIALIZATION
SUPER_ADMIN_CODE="VS-001"
SUPER_ADMIN_NAME="Vishnu"
SUPER_ADMIN_EMAIL="vishnu@vsecuretechnologies.com"
INITIAL_CAPACITY=25

# 5. GEOFENCE HQ PERIMETER DEFAULTS
DEFAULT_HQ_LATITUDE=12.9352
DEFAULT_HQ_LONGITUDE=77.6946
DEFAULT_HQ_RADIUS_METERS=100

# 6. MOBILE API CONFIGURATION (Accessed by Android APK)
EXPO_PUBLIC_API_URL="https://hrms.vsecuretechnologies.com"
EXPO_PUBLIC_APP_ENV="production"
